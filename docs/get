#!/usr/bin/env bash
# ==============================================================================
#  Cookie Launcher — tek satır kurulum (Linux + macOS)
#
#  Kullanim:
#     curl -fsSL https://cookie-launcher.github.io/get | bash
#
#  Ne yapar?
#    - Isletim sistemi ve mimariyi tespit eder (Linux x86_64 / macOS arm64+x64)
#    - GitHub Releases'ten EN SON surumu sorgular (jq gerekmez)
#    - Linux: AppImage'i ~/.local/bin'e kurar + masaustu kisayolu olusturur
#    - macOS: DMG'yi indirir, uygulamayi /Applications'a kopyalar ve
#             Gatekeeper karantinasini kaldirir (imzasiz oldugumuz icin gerekli)
#
#  Guvenlik notu: Bu script uzaktan kod calistirir. Indirmeden once
#  incelemek isterseniz:  curl -fsSL <adres>/get | less
#
#  Yalnizca kendi kullaniciniz icin kurar; sudo ISTEMEZ (macOS'ta /Applications
#  yazilamazsa ~/Applications'a kurar).
# ==============================================================================
set -euo pipefail

REPO="${COOKIE_REPO:-ananbaban3/cookie-launcher}"
API="https://api.github.com/repos/${REPO}/releases/latest"
BIN_DIR="${HOME}/.local/bin"
APP_NAME="CookieLauncher"

say()  { printf '\033[1;33m[🍪]\033[0m %s\n' "$*"; }
info() { printf '     %s\n' "$*"; }
warn() { printf '\033[1;31m[!]\033[0m %s\n' "$*" >&2; }
die()  { warn "$*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' bulunamadi. Lutfen kurup tekrar deneyin."; }

need curl
need uname

OS="$(uname -s)"
ARCH="$(uname -m)"

say "Cookie Launcher kurulumu basliyor (${OS} / ${ARCH})"

# ---------------------------------------------------------------- asset secimi
say "En son surum sorgulaniyor..."
JSON="$(curl -fsSL --max-time 30 "$API")" || die "GitHub Releases'e ulasilamadi. Internet baglantinizi kontrol edin."

# browser_download_url alanlarini jq olmadan ayikla
urls() { printf '%s' "$JSON" | tr ',' '\n' | sed -n 's/.*"browser_download_url": *"\([^"]*\)".*/\1/p'; }

pick() { # $1 = grep deseni
  urls | grep -E "$1" | head -n 1 || true
}

case "$OS" in
  Linux)
    case "$ARCH" in
      x86_64|amd64) PATTERN='_amd64\.AppImage$' ;;
      aarch64|arm64) PATTERN='_aarch64\.AppImage$' ;;
      *) die "Desteklenmeyen mimari: $ARCH (Linux icin x86_64/arm64 bekleniyor)." ;;
    esac
    URL="$(pick "$PATTERN")"
    [ -n "$URL" ] || die "Linux ($ARCH) icin paket bulunamadi. Elle indirin: https://github.com/${REPO}/releases/latest"
    TARGET="${BIN_DIR}/cookie-launcher"
    mkdir -p "$BIN_DIR"
    say "AppImage indiriliyor..."
    TMP="$(mktemp)"
    curl -fSL --progress-bar "$URL" -o "$TMP" || die "Indirme basarisiz."
    chmod +x "$TMP"
    mv -f "$TMP" "$TARGET"
    info "Kuruldu: $TARGET"

    # Masaustu kisayolu
    DESKTOP_DIR="${HOME}/.local/share/applications"
    mkdir -p "$DESKTOP_DIR"
    cat > "${DESKTOP_DIR}/cookie-launcher.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Cookie Launcher
Comment=Hafif ve acik kaynak Minecraft baslatici
Exec=${TARGET} %U
Terminal=false
Categories=Game;
StartupWMClass=CookieLauncher
DESKTOP
    info "Masaustu kisayolu: ${DESKTOP_DIR}/cookie-launcher.desktop"

    case ":$PATH:" in
      *":${BIN_DIR}:"*) ;;
      *) warn "Not: ${BIN_DIR} PATH'te degil. Eklemek icin:"
         info "  echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.bashrc && source ~/.bashrc" ;;
    esac

    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
      info "Baslatmak icin: cookie-launcher"
    else
      info "FUSE yoksa soyle calistirin: APPIMAGE_EXTRACT_AND_RUN=1 cookie-launcher"
    fi
    ;;

  Darwin)
    case "$ARCH" in
      arm64)  PATTERN='_aarch64\.dmg$' ;;
      x86_64) PATTERN='_x64\.dmg$' ;;
      *) die "Desteklenmeyen mimari: $ARCH" ;;
    esac
    URL="$(pick "$PATTERN")"
    [ -n "$URL" ] || die "macOS ($ARCH) icin DMG bulunamadi. Elle indirin: https://github.com/${REPO}/releases/latest"
    need hdiutil

    say "DMG indiriliyor..."
    TMPDIR_DL="$(mktemp -d)"
    DMG="${TMPDIR_DL}/CookieLauncher.dmg"
    curl -fSL --progress-bar "$URL" -o "$DMG" || die "Indirme basarisiz."

    say "DMG aciliyor..."
    MOUNT_POINT="$(hdiutil attach "$DMG" -nobrowse -quiet | tail -1 | awk '{$1=""; print}' | sed 's/^ *//')"
    [ -d "$MOUNT_POINT" ] || die "DMG baglanamadi."
    trap 'hdiutil detach "$MOUNT_POINT" -quiet >/dev/null 2>&1 || true' EXIT

    SRC_APP="$(find "$MOUNT_POINT" -maxdepth 1 -name '*.app' | head -n 1)"
    [ -n "$SRC_APP" ] || die "DMG icinde .app bulunamadi."

    # /Applications yazilamiyorsa kullanici klasorune kur
    DEST_DIR="/Applications"
    if [ ! -w "$DEST_DIR" ]; then
      DEST_DIR="${HOME}/Applications"
      mkdir -p "$DEST_DIR"
      info "/Applications yazilamiyor, ${DEST_DIR} kullaniliyor."
    fi

    say "Uygulama kopyalaniyor -> ${DEST_DIR}/${APP_NAME}.app"
    rm -rf "${DEST_DIR}/${APP_NAME}.app"
    cp -R "$SRC_APP" "${DEST_DIR}/"

    hdiutil detach "$MOUNT_POINT" -quiet >/dev/null 2>&1 || true
    trap - EXIT
    rm -rf "$TMPDIR_DL"

    # Imzasiz oldugumuz icin Gatekeeper karantinasini kaldir
    say "Karantina kaldiriliyor (imzasiz surum uyarisi icin)..."
    xattr -dr com.apple.quarantine "${DEST_DIR}/${APP_NAME}.app" 2>/dev/null || true

    info "Kuruldu: ${DEST_DIR}/${APP_NAME}.app"
    info "Baslatmak icin: open \"${DEST_DIR}/${APP_NAME}.app\""
    ;;

  *)
    die "Bu script yalnizca Linux ve macOS icindir. Windows icin setup.exe indirin: https://github.com/${REPO}/releases/latest"
    ;;
esac

say "Tamamlandi ✓  Iyi oyunlar!"
